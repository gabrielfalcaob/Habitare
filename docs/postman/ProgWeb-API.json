  "item": [
    {
      "name": "01 - Listar imóveis (público, sem token)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('ts', Date.now().toString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Retorna lista', () => pm.expect(pm.response.json()).to.be.an('array'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/imoveis",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "imoveis"
          ]
        },
        "auth": {
          "type": "noauth"
        }
      }
    },

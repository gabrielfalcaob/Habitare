              "pm.test('Status 401', () => pm.response.to.have.status(401));",
              "pm.test('Formato problem+json', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('problem+json'));",
              "pm.test('Sem stack trace na resposta', () => pm.expect(pm.response.text()).to.not.include('at br.edu'));"
